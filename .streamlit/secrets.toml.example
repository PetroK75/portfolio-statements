# Copy to .streamlit/secrets.toml for local runs (git-ignored), or paste into
# the Streamlit Community Cloud app's Settings → Secrets. Never commit real values.

[app]
# Long random passphrase. This is the only gate if the app ends up public.
password = "change-me"

[connections.db]
# Supabase → Project Settings → Database → Connection string → "Session pooler"
# (IPv4-friendly; Streamlit Cloud has no IPv6). Use the postgresql:// form.
url = "postgresql://postgres.<project-ref>:<db-password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# For local development without Supabase you can use SQLite instead:
# url = "sqlite:///local.db"
