# in the repo are synthetic test fixtures under tests/fixtures/.
*.pdf
*.csv
*.xls
*.xlsx
*.xlsm
*.ofx
*.qfx
*.qif
!tests/fixtures/*.csv
statements/
private/
data/
*.sqlite
*.db

# --- Python -------------------------------------------------------------------
.venv/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
